// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                Int        @id @default(autoincrement())
  name              String
  email             String     @unique
  password_hash     String
  refreshToken      String?
  dept_id           Int
  department        Department @relation(fields: [dept_id], references: [id])
  isActive          Boolean    @default(true)
  roles             UserRole[]
  uploadedDocuments Document[]
  uploadedVersions  DocumentVersion[]

  auditLogs AuditLog[]

  createdFolders Folder[]

  documentsSharedWithMe DocumentShare[] @relation("DocumentSharedWithUser")
  documentsSharedByMe   DocumentShare[] @relation("DocumentSharedByUser")

  submittedWorkflows      DocumentWorkflow[] @relation("WorkflowSubmittedBy")
  assignedReviewWorkflows DocumentWorkflow[] @relation("WorkflowReviewer")
  assignedByWorkflows     DocumentWorkflow[] @relation("WorkflowAssignedBy")
  cancelledWorkflows      DocumentWorkflow[] @relation("WorkflowCancelledBy")

  workflowActions       WorkflowHistory[] @relation("WorkflowHistoryPerformedBy")
  workflowReviewActions WorkflowHistory[] @relation("WorkflowHistoryReviewer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  users           UserRole[]
  rolePermissions RolePermission[]
}

model UserRole {
  user_id Int
  role_id Int
  user    User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role    Role @relation(fields: [role_id], references: [id], onDelete: Cascade)

  assigned_by Int?
  assigned_at DateTime @default(now())

  @@id([user_id, role_id])
}

model Permission {
  id              Int              @id @default(autoincrement())
  resource        String
  action          String
  scope           String           @default("all")
  rolePermissions RolePermission[]

  @@unique([resource, action, scope])
}

model RolePermission {
  role_id       Int
  permission_id Int
  role          Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
}

model Department {
  id        Int    @id @default(autoincrement())
  name      String @unique
  parent_id Int?

  parent    Department?  @relation("DeptToDept", fields: [parent_id], references: [id])
  sub_depts Department[] @relation("DeptToDept")

  users User[]

  documents Document[]
  folders   Folder[]
}

model Folder {
  id          Int     @id @default(autoincrement())
  name        String
  description String?

  parent_id Int?
  parent    Folder?  @relation("FolderHierarchy", fields: [parent_id], references: [id])
  children  Folder[] @relation("FolderHierarchy")

  dept_id    Int?
  department Department? @relation(fields: [dept_id], references: [id])

  createdById Int?
  createdBy   User? @relation(fields: [createdById], references: [id])

  documents Document[]

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isDeleted])
}

enum DocumentStatus {
  DRAFT
  ACTIVE
  UNDER_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
  DELETED
}

model Document {
  id Int @id @default(autoincrement())

  title       String
  description String?

  versions DocumentVersion[]

  originalName String
  fileName     String
  mimeType     String
  fileSize     Int

  bucketName String
  objectKey  String @unique

  status     DocumentStatus @default(ACTIVE)
  isArchived Boolean        @default(false)
  archivedAt DateTime?
  archivedBy Int?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy Int?

  dept_id     Int
  folder_id   Int
  uploaded_by Int

  folder     Folder     @relation(fields: [folder_id], references: [id])
  department Department @relation(fields: [dept_id], references: [id])
  uploadedBy User       @relation(fields: [uploaded_by], references: [id])

  metadata DocumentMetadata[]
  shares   DocumentShare[]

  workflow        DocumentWorkflow?
  workflowHistory WorkflowHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([folder_id])
  @@index([dept_id])
  @@index([uploaded_by])
  @@index([status])
  @@index([isArchived])
  @@index([isDeleted])
}

enum MetadataFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
}

model MetadataField {
  id Int @id @default(autoincrement())

  name String
  key  String            @unique
  type MetadataFieldType @default(TEXT)

  isRequired Boolean @default(false)
  isActive   Boolean @default(true)

  options Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documentMetadata DocumentMetadata[]

  @@index([key])
  @@index([type])
  @@index([isActive])
}

model DocumentMetadata {
  id Int @id @default(autoincrement())

  document_id      Int
  metadataField_id Int

  value String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  document      Document      @relation(fields: [document_id], references: [id])
  metadataField MetadataField @relation(fields: [metadataField_id], references: [id])

  @@unique([document_id, metadataField_id])
  @@index([document_id])
  @@index([metadataField_id])
}

enum SharePermission {
  VIEW
  DOWNLOAD
}

model DocumentShare {
  id Int @id @default(autoincrement())

  document_id      Int
  sharedWithUserId Int
  sharedByUserId   Int

  permission SharePermission @default(VIEW)

  message String?

  expiresAt DateTime?
  isRevoked Boolean   @default(false)
  revokedAt DateTime?
  revokedBy Int?

  document       Document @relation(fields: [document_id], references: [id])
  sharedWithUser User     @relation("DocumentSharedWithUser", fields: [sharedWithUserId], references: [id])
  sharedByUser   User     @relation("DocumentSharedByUser", fields: [sharedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([document_id, sharedWithUserId])
  @@index([document_id])
  @@index([sharedWithUserId])
  @@index([sharedByUserId])
  @@index([permission])
  @@index([isRevoked])
  @@index([expiresAt])
}

enum WorkflowStatus {
  PENDING_REVIEW
  IN_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum WorkflowAction {
  SUBMITTED
  REVIEWER_ASSIGNED
  REVIEWER_REASSIGNED
  APPROVED
  REJECTED
  CANCELLED
}

model DocumentWorkflow {
  id Int @id @default(autoincrement())

  document_id Int @unique

  status WorkflowStatus @default(PENDING_REVIEW)

  submittedById Int
  submittedAt   DateTime @default(now())

  reviewerId   Int?
  assignedById Int?
  assignedAt   DateTime?

  reviewedAt    DateTime?
  reviewComment String?

  completedAt   DateTime?
  cancelledAt   DateTime?
  cancelledById Int?
  cancelReason  String?

  document Document @relation(fields: [document_id], references: [id])

  submittedBy User  @relation("WorkflowSubmittedBy", fields: [submittedById], references: [id])
  reviewer    User? @relation("WorkflowReviewer", fields: [reviewerId], references: [id])
  assignedBy  User? @relation("WorkflowAssignedBy", fields: [assignedById], references: [id])
  cancelledBy User? @relation("WorkflowCancelledBy", fields: [cancelledById], references: [id])

  history WorkflowHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([document_id])
  @@index([status])
  @@index([submittedById])
  @@index([reviewerId])
  @@index([assignedById])
}

model WorkflowHistory {
  id Int @id @default(autoincrement())

  workflow_id Int
  document_id Int

  action     WorkflowAction
  fromStatus WorkflowStatus?
  toStatus   WorkflowStatus?

  performedById Int

  reviewerId Int?
  comment    String?

  workflow    DocumentWorkflow @relation(fields: [workflow_id], references: [id])
  document    Document         @relation(fields: [document_id], references: [id])
  performedBy User             @relation("WorkflowHistoryPerformedBy", fields: [performedById], references: [id])
  reviewer    User?            @relation("WorkflowHistoryReviewer", fields: [reviewerId], references: [id])

  createdAt DateTime @default(now())

  @@index([workflow_id])
  @@index([document_id])
  @@index([performedById])
  @@index([reviewerId])
  @@index([action])
  @@index([createdAt])
}

model DocumentVersion {
  id Int @id @default(autoincrement())

  document_id   Int
  versionNumber Int

  originalName String
  fileName     String
  mimeType     String
  fileSize     Int

  bucketName String
  objectKey  String

  isCurrent Boolean @default(false)

  changeNote String?

  uploaded_By Int

  document   Document @relation(fields: [document_id], references: [id])
  uploadedBy User     @relation(fields: [uploaded_By], references: [id])

  createdAt DateTime @default(now())

  @@unique([document_id, versionNumber])
  @@index([document_id])
  @@index([uploaded_By])
  @@index([isCurrent])
}

enum AuditAction {
  
  DOCUMENT_CREATED
  DOCUMENT_VIEWED
  DOCUMENT_UPDATED
  DOCUMENT_DELETED
  DOCUMENT_ARCHIVED
  DOCUMENT_RESTORED
  DOCUMENT_DOWNLOADED
  DOCUMENT_SHARED
  DOCUMENT_SHARE_REMOVED
  DOCUMENT_VERSION_CREATED
  DOCUMENT_VERSION_RESTORED

  FOLDER_CREATED
  FOLDER_UPDATED
  FOLDER_DELETED
  FOLDER_MOVED

  DEPARTMENT_CREATED
  DEPARTMENT_UPDATED
  DEPARTMENT_DELETED

  WORKFLOW_SUBMITTED
  WORKFLOW_REVIEWER_ASSIGNED
  WORKFLOW_APPROVED
  WORKFLOW_REJECTED
  WORKFLOW_CANCELLED

  USER_CREATED
  USER_UPDATED
  USER_DISABLED
  USER_ACTIVATED
  USER_ROLE_ASSIGNED
  USER_ROLE_REMOVED

  ROLE_CREATED
  ROLE_UPDATED
  ROLE_DELETED
  
  PERMISSION_CREATED
  PERMISSION_UPDATED
  PERMISSION_DELETED
  PERMISSION_ASSIGNED_TO_ROLE
  PERMISSION_REMOVED_FROM_ROLE

  USER_LOGIN
  USER_LOGOUT

  METADATA_FIELD_CREATED
  METADATA_FIELD_UPDATED
  METADATA_FIELD_DELETED
  DOCUMENT_METADATA_ADDED
  DOCUMENT_METADATA_UPDATED
  DOCUMENT_METADATA_REMOVED
}

model AuditLog {
  id         Int         @id @default(autoincrement())
  action     AuditAction
  resource   String      
  resourceId Int?        
  userId     Int         
  metadata   Json?      
  ipAddress  String?
  userAgent  String?

  user       User        @relation(fields: [userId], references: [id])

  createdAt  DateTime    @default(now())

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([resourceId])
  @@index([createdAt])
}