// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  password_hash String
  refreshToken  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  dept_id       Int
  department    Department @relation(fields: [dept_id], references: [id])
  isActive      Boolean  @default(true)
  roles         UserRole[]
  uploadedDocuments Document[]

  createdFolders Folder[]
}

model Role {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  users           UserRole[]
  rolePermissions RolePermission[]
}

model UserRole {
  user_id Int
  role_id Int
  user    User @relation(fields: [user_id], references: [id])
  role    Role @relation(fields: [role_id], references: [id])

  assigned_by Int?
  assigned_at DateTime @default(now())

  @@id([user_id, role_id])
}

model Permission {
  id              Int              @id @default(autoincrement())
  resource        String
  action          String
  scope           String           @default("all")
  rolePermissions RolePermission[]

  @@unique([resource, action, scope])
}

model RolePermission {
  role_id       Int
  permission_id Int
  role          Role       @relation(fields: [role_id], references: [id])
  permission    Permission @relation(fields: [permission_id], references: [id])

  @@id([role_id, permission_id])
}

model Department {
  id        Int    @id @default(autoincrement())
  name      String @unique
  parent_id Int?

  parent    Department?  @relation("DeptToDept", fields: [parent_id], references: [id])
  sub_depts Department[] @relation("DeptToDept")

  users User[]

  documents Document[]
  folders Folder[]
}

model Folder {
  id          Int      @id @default(autoincrement())
  name        String
  description String?

  parent_id    Int?
  parent      Folder?  @relation("FolderHierarchy", fields: [parent_id], references: [id])
  children    Folder[] @relation("FolderHierarchy")

  dept_id     Int?
  department  Department? @relation(fields: [dept_id], references: [id])

  createdById Int?
  createdBy   User? @relation(fields: [createdById], references: [id])
  
  documents   Document[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum DocumentStatus {
  DRAFT
  ACTIVE
  UNDER_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
  DELETED
}

model Document {
  id            Int            @id @default(autoincrement())

  title         String
  description   String?

  originalName  String
  fileName      String
  mimeType      String
  fileSize      Int

  bucketName    String
  objectKey     String         @unique

  status        DocumentStatus @default(ACTIVE)
  isArchived    Boolean        @default(false)
  archivedAt    DateTime?
  archivedBy    Int?

  isDeleted     Boolean        @default(false)
  deletedAt     DateTime?
  deletedBy     Int?

  dept_id       Int
  folder_id     Int
  uploaded_by   Int

  folder        Folder         @relation(fields: [folder_id], references: [id])
  department    Department     @relation(fields: [dept_id], references: [id])
  uploadedBy    User           @relation(fields: [uploaded_by], references: [id])

  metadata      DocumentMetadata[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([folder_id])
  @@index([dept_id])
  @@index([uploaded_by])
  @@index([status])
  @@index([isArchived])
  @@index([isDeleted])
}

enum MetadataFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
}

model MetadataField {
  id          Int               @id @default(autoincrement())

  name        String
  key         String            @unique
  type        MetadataFieldType @default(TEXT)

  isRequired  Boolean           @default(false)
  isActive    Boolean           @default(true)

  options     Json?

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  documentMetadata DocumentMetadata[]

  @@index([key])
  @@index([type])
  @@index([isActive])
}

model DocumentMetadata {
  id               Int      @id @default(autoincrement())

  document_id      Int
  metadataField_id Int

  value            String

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  document         Document      @relation(fields: [document_id], references: [id])
  metadataField    MetadataField @relation(fields: [metadataField_id], references: [id])

  @@unique([document_id, metadataField_id])
  @@index([document_id])
  @@index([metadataField_id])
}